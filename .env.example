# This project uses Cloudflare Worker secrets, not browser environment variables.
# Public non-secret values live in wrangler.jsonc.
TURNSTILE_SECRET_KEY=replace_me
TURNSTILE_EXPECTED_HOSTNAME=preview.example.workers.dev
RATE_LIMIT_SECRET=replace_me
SESSION_SECRET=replace_me
# PBKDF2-HMAC-SHA-256 verifier created by scripts/generate-organizer-password-hash.mjs.
ORGANIZER_PASSWORD_HASH=pbkdf2-sha256$310000$replace_with_base64url_salt$replace_with_base64url_digest
RESEND_API_KEY=replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me
# Store the private workshop WhatsApp invitation only in Cloudflare secrets.
WORKSHOP_WHATSAPP_GROUP_URL=replace_me
