{
  "name": "lumenet-labs-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:copy": "! rg '[—–]' app public README.md docs SECURITY.md PRIVACY-CHECKLIST.md",
    "check": "npm run typecheck && npm run test && npm run build && npm run check:copy",
    "db:migrate:local": "wrangler d1 migrations apply lumenet-platform-preview --local",
    "db:seed:local": "wrangler d1 execute lumenet-platform-preview --local --file=./seed/preview.sql",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "organizer:hash": "node scripts/generate_organizer_hash.mjs",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "fflate": "^0.8.3",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
